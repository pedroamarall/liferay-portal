definition {

	macro openHome {
		Click(locator1="MyTestFile#BUTTON_HOME");
	}

	macro openContentData {
		Click(locator1="MyTestFile#BUTTON_CONTENT_DATA");
	}

	macro openForms { 
		Click(locator1="MyTestFile#BUTTON_FORMS");
	}

	macro openDataProviders {
		Click(locator1="MyTestFile#OPEN_DATA_PROVIDERS");
	}

	macro openDropdownMenu {
		Click(locator1="MyTestFile#DROPDOWN_MENU");
	}

	macro openSimulation {
		Click(locator1="MyTestFile#OPEN_SIMULATION");
	}

	macro openAllItensSimulation {
		Click(
			key_entryItens = "${entryItens}",

			locator1 = "MyTestFile#OPEN_ITENS_SIMULATION");
	}

	macro openNewForm {
		Click(locator1="MyTestFile#OPEN_NEWFORM");
	}

	macro openTextField {
		Click(locator1="MyTestFile#OPEN_FIELD_TEXT");
	}

	macro openTextFielNumeric {
		Click(locator1="MyTestFile#OPEN_FIELD_NUMERIC");
	}

}

