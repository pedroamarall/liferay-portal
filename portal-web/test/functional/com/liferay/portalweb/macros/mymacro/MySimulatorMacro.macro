definition {

	macro EditSimulationSizeAndClose {
		var key_deviceType = "Apply Custom Size";

		SelectFieldText.selectFieldText(
			locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_WIDTH_FIELD",
			value1 = ${width});

		Type.sendKeys(
			locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_WIDTH_FIELD",
			value1 = ${width});

		SelectFieldText.selectFieldText(
			locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_HEIGHT_FIELD",
			value1 = ${height});

		Type.sendKeys(
			locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_HEIGHT_FIELD",
			value1 = ${height});

		Click(locator1 = "ControlMenuPreviewPanel#PREVIEW_DATA_DEVICE_BUTTON");

		Click(locator1 = "MyCustomPath#CLOSE_BUTTON");
	}

	macro GoToSimulation {
		Click(locator1 = "ControlMenu#SIMULATION");

		Click(
			key_deviceType = "Custom",
			locator1 = "ControlMenuPreviewPanel#PREVIEW_DATA_DEVICE_BUTTON");
	}

	macro ValidateSimulationValues {
		MySimulatorMacro.GoToSimulation(key_deviceType = "Apply Custom Size");

		AssertTextEquals(
			locator1 = "MyCustomPath#ALERT_SIZE",
			value1 = "Custom Size ${height}x${width} Applied");
	}

}