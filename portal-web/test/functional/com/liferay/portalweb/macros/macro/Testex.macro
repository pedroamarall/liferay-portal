definition {

	macro addfieldsForm {
		Form.editName(formName = ${formName});

			Form.editDescription(formDescription = ${formDescription});

			Form.editPageTitle(
				formPageName = "${formPageName}",
				formTitleNumber = ${formTitleNumber});

			Form.gotoAddField(
				fieldPositionNumber = ${fieldPositionNumber},
				fieldType = ${fieldType1});

			Form.editFieldLabelMetal(fieldValue = ${fieldValue1});

			Form.closeSidebar();

			Form.save();

			Form.gotoAddField(
				fieldPositionNumber = ${fieldPositionNumber2},
				fieldType = ${fieldType2});

			Form.editFieldLabelMetal(fieldValue = ${fieldValue2});

			Form.save();

	}
	macro changeFieldsform {

		Form.editName(formName = "form frc ");

			Form.editDescription(formDescription = "form en frc");

			Form.editPageTitle(
				formPageName = "Creation formulaire en frc",
				formTitleNumber = 1);

			Click(
				key_fieldName = "Full Name",
				locator1 = "FormFields#TEXT_FIELD");

			Form.editFieldLabelMetal(fieldValue = "Nom Prenom");

			Click(
				key_fieldName = "Age",
				locator1 = "FormFields#TEXT_FIELD");

			Form.editFieldLabelMetal(fieldValue = "Age");

			Form.save();

	}
	macro CheckForm {
		FormsAdminNavigator.gotoViewEntries();

		LexiconEntry.viewEntryName(rowEntry = ${rowEntry});

		LexiconEntry.viewEntryContent(
			rowAny = ${rowAny},
			rowEntry =${rowEntry2});
	}

	macro editBlogEntry {
		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Edit",
			rowEntry = ${rowEntry});

		BlogsEntry.editTitle(
			entryTitle = ${entryTitle},
			entryTitleEdit = ${entryTitleEdit});

		Button.clickPublish();
	}
	macro fillForm {
		FormFields.editText(
				fieldName = "Full Name",
				fieldValue = "Adnan");

			FormFields.editText(
				fieldName = "Age",
				fieldValue = 22);

			FormPortlet.submit();

			Form.submitAgain();
	}
	macro fillFormFrench {
		FormFields.editText(
				fieldName = "Nom Prenom",
				fieldValue = "Adnan");

			FormFields.editText(
				fieldName = "Age",
				fieldValue = 22);

			FormPortlet.submit();

			Form.submitAgain();
	}

	macro previewSize {
		TripleClick(locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_HEIGHT_FIELD");

		Type.sendKeys(
			locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_HEIGHT_FIELD",
			value1 = 1920);

		TripleClick(locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_WIDTH_FIELD");

		Type.sendKeys(
			locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_WIDTH_FIELD",
			value1 = 1080);
	}

}