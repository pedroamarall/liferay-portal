definition {

	macro createNewForm {
		FormsAdmin.addForm();

		Form.editName(formName = "First Form");

		Form.editDescription(formDescription = "Form Description 1");

		Form.gotoAddField(
			fieldPositionNumber = 0,
			fieldType = "Text");

		Form.editFieldLabelMetal(fieldValue = "Full Name");

		Form.save();

		Form.gotoAddField(
			fieldPositionNumber = 1,
			fieldType = "Numeric");

		Form.editFieldLabelMetal(fieldValue = "Age");

		Form.save();
	}

	macro previewsize {
		TripleClick(locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_HEIGHT_FIELD");

		Type.sendKeys(
			locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_HEIGHT_FIELD",
			value1 = ${height});
		
		TripleClick(locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_WIDTH_FIELD");

		Type.sendKeys(
			locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_WIDTH_FIELD",
			value1 =${width});
			
	}

	macro translateFormFrench {
		Form.addTranslation(localizedLanguage = "French (France)");

		Click(
			key_name = "Full Name",
			locator1 = "FormFields#FIELD_TARGET_LABEL");

		FormFields.editText(
			fieldName = "Label",
			fieldValue = "nom et prénom");

		Click(
			key_name = "Age",
			locator1 = "FormFields#FIELD_TARGET_LABEL");

		Form.editFieldLabelMetal(fieldValue = "âge");

		Form.save();
	}

	macro validateApply {
        
		AssertElementPresent(locator1 = "ControlMenu#SIMULATION");

		Click(locator1 = "ControlMenu#SIMULATION");

		AssertTextEquals(

			locator1 = "MyTests#ALERTE",
			value1 = "Custom Size  ${height}x${width} Applied");

         
	}

	macro validateFormPublish {
		Form.publishForm();

		FormsAdminNavigator.gotoPublishedForm();

		FormFields.editText(
			fieldName = "Full Name",
			fieldValue = "Published Paragraph entry");

		FormFields.editText(
			fieldName = "Age",
			fieldValue = 12);

		FormPortlet.submitSuccessfully();

		Form.submitAgain();

		FormPortletConfiguration.changeLanguage(
			currentLanguage = "en-US",
			newLanguage = "français-France");

		FormFields.editText(
			fieldName = "nom et prénom",
			fieldValue = "Entrée de paragraphe publié");

		FormFields.editText(
			fieldName = "âge",
			fieldValue = 12);

		FormPortlet.submitSuccessfully();

		Form.submitAgain();

		Navigator.openURL();

		ProductMenu.gotoPortlet(
			category = "Content & Data",
			portlet = "Forms");

		FormsAdminNavigator.gotoViewEntries();

		FormsAdminNavigator.gotoBack();
	}

}