definition {

	macro modifyHeightAndWidthAndApplyCustomSize {
		TripleClick(locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_HEIGHT_FIELD");

		Type.sendKeys(
			locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_HEIGHT_FIELD",
			value1 = ${height});

		TripleClick(locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_WIDTH_FIELD");

		Type.sendKeys(
			locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_WIDTH_FIELD",
			value1 = ${width});

		Click(locator1 = "myTests#APPLY_CUSTOM_SIZE");
	}

	macro selectCustomOption {
		Click.waitForMenuToggleJSClick(locator1 = "ControlMenu#SIMULATION");

		Click(
			key_deviceType = "Custom",
			locator1 = "ControlMenuPreviewPanel#PREVIEW_DATA_DEVICE_BUTTON");
	}

	macro translateFormLabelFieldAndPublish {
		Form.addTranslation(localizedLanguage = "French (France)");

		Form.editPageTitle(
			formPageName = "Francais",
			formTitleNumber = 1);

		Click(
			key_name = "Full Name",
			locator1 = "FormFields#FIELD_TARGET_LABEL");

		FormFields.editText(
			fieldName = "Label",
			fieldValue = ${textLabelFrench});

		Click(
			key_name = "Age",
			locator1 = "FormFields#FIELD_TARGET_LABEL");

		FormFields.editText(
			fieldName = "Label",
			fieldValue = ${ageLabelFrench});

		Form.save();

		Form.publishForm();
	}

}