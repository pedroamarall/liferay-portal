<html>
<head>
<title>MyCustomPath</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MyCustomPath</td></tr>
</thead>

<tbody>
<tr>
	<td>CONFIGURATION</td>
	<td>*[contains(@role,'tabpanel') and contains(@class,'active')]*[text()="${category}"]</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_BUTTON</td>
	<td>*[contains(@class, 'simulation-panel')]*[@aria-label="Close"]</td>
	<td></td>
</tr>
<tr>
	<td>ALERT_SIZE</td>
	<td>*[contains(.,"Simulation")]*[contains(@class,'alert')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>