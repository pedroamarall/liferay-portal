<html>
<head>
<title>MyCustomPath</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MyCustomPath</td></tr>
</thead>

<tbody>
<tr>
	<td>CONFIGURATION</td>
	<td>//div[contains(@role,'tabpanel') and contains(@class,'active')]//h2[text()="${category}"]</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_BUTTON</td>
	<td>//*[@id="_com_liferay_product_navigation_simulation_web_portlet_SimulationPortlet_simulationPanelId"]/div[1]/div[1]/button</td>
	<td></td>
</tr>
<tr>
	<td>ALERT_SIZE</td>
	<td>//div[contains(@class,'alert')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>