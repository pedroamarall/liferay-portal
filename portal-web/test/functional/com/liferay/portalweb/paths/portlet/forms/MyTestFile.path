<html>
<head>
<title>MyTestFile</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MyTestFile</td></tr>
</thead>

<tbody>
<tr>
	<td>BUTTON_HOME</td>
	<td>//a[contains(@data-open-class, 'open product-menu-open')] </td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_CONTENT_DATA</td>
	<td>//a[contains(@class, 'collapse-icon') and contains(text(), 'Content')]</td>
	<td></td>
</tr>
<tr>
	<td>BUTTON_FORMS</td>
	<td>//a[contains(@class, 'nav-link') and contains(text(), 'Forms')]</td>
	<td></td>
</tr>
<tr>
	<td>OPEN_DATA_PROVIDERS</td>
	<td>//li[contains(@data-nav-item-index, "2")]</td>
	<td></td>
</tr>
<tr>
	<td>DROPDOWN_MENU</td>
	<td>//button[contains(@class, 'dropdown-toggle') and contains(@class, 'lfr-portal-tooltip')]</td>
	<td></td>
</tr>
<!-- <tr>
	<td>OPTION_MENU</td>
	<td>//button[contains(@class, 'nav-link')]//span[contains(text(), "${key_optionsMenu}")]</td>
	<td></td>
</tr> -->
<tr>
	<td>OPEN_SIMULATION</td>
	<td>//li[contains(@class, 'control-menu-nav-item')]//a[contains(@aria-label, 'Simulation')]</td>
	<td></td>
</tr>
<tr>
	<td>OPEN_ITENS_SIMULATION</td>
	<td>//button[contains(@class, 'btn btn-unstyled')]//span[contains(.,'${key_entryItens}')]</td>
	<td></td>
</tr>
<tr>
	<td>OPEN_NEWFORM</td>
	<td>//a[contains(@class, 'nav-btn nav-btn-monospaced')]</td>
	<td></td>
</tr>
<tr>
	<td>FORM_CONTROL</td>
	<td>//textarea[contains(@class, 'ddm-form-description')]</td>
	<td></td>
</tr>
<tr>
	<td>OPEN_FIELD_TEXT</td>
	<td>//div[contains(@class, 'ddm-field-actions-container')]</td>
	<td></td>
</tr>
<tr>
	<td>OPEN_FIELD_NUMERIC</td>
	<td>//div[contains(@data-field-name, 'Numeric38424022') and contains(@class, 'ddm-field-container')]
	</td>
	<td></td>
</tr>
<tr>
	<td>FIELD_LABEL</td>
	<td>//input[contains(@placeholder, 'Enter a field label.')]
	</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>




