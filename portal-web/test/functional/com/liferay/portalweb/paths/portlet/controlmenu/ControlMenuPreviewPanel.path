<html>
	<head>
		<title>ControlMenuPreviewPanel</title>
	</head>

	<body>
		<table border="1" cellpadding="1" cellspacing="1">
			<thead>
				<tr><td rowspan="1" colspan="3">ControlMenuPreviewPanel</td></tr>
			</thead>

			<tbody>
				<tr>
					<td>PREVIEW_DATA_DEVICE_BUTTON</td>
					<td>//div[contains(@id,'simulationDevice')]//button[normalize-space()='${key_deviceType}']</td>
					<td></td>
				</tr>
				<tr>
					<td>PREVIEW_CUSTOM_WIDTH_FIELD</td>
					<td>//input[contains(@id,'_width')]</td>
					<td></td>
				</tr>
				<tr>
					<td>PREVIEW_CUSTOM_HEIGHT_FIELD</td>
					<td>//input[contains(@id,'_height')]</td>
					<td></td>
				</tr>
				<tr>
					<td>PREVIEW_DEVICE_IFRAME</td>
					<td>//div[contains(@class,'${key_deviceType}')]//iframe</td>
					<td></td>
				</tr>
				<tr>
					<td>PREVIEW_DEVICE_GENERAL_IFRAME</td>
					<td>//div[contains(@class,'simulation-preview')]//iframe</td>
					<td></td>
				</tr>
				<tr>
					<td>PREVIEW_CONFIRM</td>
					<td>//button[@aria-label='Apply Custom Size']</td>
					<td></td>
				</tr>
				<tr>
					<td>PREVIEW_EXIT</td>
					<td>//button[@class='btn btn-monospaced btn-unstyled close sidenav-close']</td>
					<td></td>
				</tr>
				<tr>
					<td>PREVIEW_APPLIED_CHANGES</td>
					<td>//div[contains(text(),'Applied') and contains(@class, 'autofit-section')]</td>
					<td></td>
				</tr>
			</tbody>
		</table>
	</body>
</html>