@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		task ("Given the Blogs Portlet is added to the page") {
			Blogs.addEntry(
				entryContent = "Extra Blog",
				entryTitle = "Extra Blog");

			AssertElementPresent(
				key_entryTitle = "Extra Blog",
				locator1 = "Blogs#ADD_BLOGS_ENTRY");
		}
	}

	@description = "Can Delete a Blog"
	@priority = 5
	test CanDeleteBlog {
		Blogs.addEntry(
			entryContent = "Blog Content Zindigi",
			entryTitle = "Blog Zindigi");

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Delete",
			rowEntry = "Blog Zindigi");
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanEditBlog {

		//BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");

		Blogs.addEntry(
			entryContent = "Blog Content Zindigi",
			entryTitle = "Blog Zindigi");

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Edit",
			rowEntry = "Blog Zindigi");

		BlogsEntry.editTitle(
			entryTitle = "Blog Zindigi",
			entryTitleEdit = "Blog Malmali");
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSearchBlogs {
		Blogs.addEntry(
			entryContent = "Blog Content Liferay",
			entryTitle = "Blog Liferay");

		BlogsEntry.searchCP(entrySearchTerm = "Blog Liferay");
	}

}