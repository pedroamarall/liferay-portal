@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		task ("Given: the Blogs Portlet is added to the page") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");
		}

		task ("When: the user adds a Blog Entry") {
			JSONBlog.addEntry(
				entryContent = "first Blog",
				entryTitle = "first Blog");
			Refresh();
		}

		task ("Then: the Blog Entry should display on the page") {
			AssertElementPresent(
				key_entryTitle = "first Blog",
				key_tagName = "first Blog",
				locator1 = "BlogsEntry#TAG");

		}
	}

	@description = "Can Delete a Blog"
	@priority = 5
	test CanDeleteBlog {
		task ("Given: the Blogs Portlet is added to the page") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");

			JSONBlog.addEntry(
				entryContent = "first Blog",
				entryTitle = "first Blog");

			JSONBlog.addEntry(
				entryContent = "second Blog",
				entryTitle = "second Blog");
			Refresh();
		}

		task ("And: a 2 Blog Entries exists") {
			AssertElementPresent(
				key_entryTitle = "first Blog",
				key_tagName = "first Blog",
				locator1 = "BlogsEntry#TAG"
			);
			AssertElementPresent(
				key_entryTitle = "second Blog",
				key_tagName = "second Blog",
				locator1 = "BlogsEntry#TAG"
			);
		}

		task ("When: the User deletes Blog Entry 1") {
			JSONBlog.moveEntryToTrash(
				entryTitle = "first Blog",
				groupName = "Guest");
			Refresh();
		}

		task ("Then: Blog Entry 1 should not exist") {
			AssertElementNotPresent(
				key_entryTitle = "first Blog",
				key_tagName = "first Blog",
				locator1 = "BlogsEntry#TAG");
		}

		task ("And: Blog Entry 2 should exist") {
			AssertElementPresent(
				key_entryTitle = "second Blog",
				key_tagName = "second Blog",
				locator1 = "BlogsEntry#TAG"
			);
		}
	}

	@description = "Can Edit a Blog"
	@priority = 5
	test CanEditBlog {
		task ("Given: the Blogs Portlet is added to the page") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");

			JSONBlog.addEntry(
				entryContent = "first Blog",
				entryTitle = "first Blog",
				groupName = "Guest");
			Refresh();
		}

		task ("And: a Blog Entry exists") {
			AssertElementPresent(
				key_entryTitle = "first Blog",
				key_tagName = "first Blog",
				locator1 = "BlogsEntry#TAG"
			);
		}

		task ("When: the user Edit the Blog Entry") {
			JSONBlog.updateEntry(
				entryContent = "first Blog",
				entryTitle = "first Blog",
				groupName = "Guest");

			Refresh();
		}

		task ("Then: the Blog Entry should be edited") {
			AssertElementPresent(
				key_entryTitle = "first Blog",
				key_tagName = "first Blog",
				locator1 = "BlogsEntry#TAG"
			);
		}
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSearchBlogs {
		task ("Given: the Blogs Portlet is added to the page") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");

			JSONBlog.addEntry(
				entryContent = "first Blog",
				entryTitle = "first Blog",
				groupName = "Guest");

			JSONBlog.addEntry(
				entryContent = "second",
				entryTitle = "second",
				groupName = "Guest");
			Refresh();
		}

		task ("And: a 2 Blog Entries exists") {
			AssertElementPresent(
				key_entryTitle = "first Blog",
				key_tagName = "first Blog",
				locator1 = "BlogsEntry#TAG"
			);

			AssertElementPresent(
				key_entryTitle = "second",
				key_tagName = "second",
				locator1 = "BlogsEntry#TAG"
			);
		}

		task ("When: the User searches for Blog Entry 1") {
			BlogsEntry.searchCP(
				entryContent = "first Blog",
				entrySearchTerm = "first Blog",
				entryTitle = "first Blog");
		}

		task ("Then: Blog Entry 1 should display") {
			AssertElementPresent(
				key_entryTitle = "first Blog",
				key_tagName = "first Blog",
				locator1 = "BlogsEntry#TAG"
			);
		}

		task ("And: Blog Entry 2 should not display") {
			AssertElementNotPresent(
				key_entryTitle = "second",
				key_tagName = "second",
				locator1 = "BlogsEntry#TAG");
		}
	}

}