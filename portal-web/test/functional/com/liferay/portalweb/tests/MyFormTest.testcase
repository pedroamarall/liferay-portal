@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		task ("Open New Instance of Liferay") {
			TestCase.setUpPortalInstance();
		}

		task ("Login") {
			User.firstLoginPG();
		}

		task ("Navigate To The Instance") {
			Navigator.openURL();
		}
	}

	tearDown {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");
	}

	@description = "Create A New Form With Text Field And Numeric Field"
	@priority = 5
	test AddFormWithTextFieldAndNumericField {
		task ("Given Create The Form With The Fields") {
			FormsAdmin.addForm();

			Form.editName(formName = "Form 1");

			Form.editPageTitle(
				formPageName = "English",
				formTitleNumber = 1);

			Form.gotoAddField(
				fieldPositionNumber = 0,
				fieldType = "Text");

			Form.editFieldLabelMetal(fieldValue = "Full Name");

			Form.closeSidebar();

			Form.save();

			Form.gotoAddField(
				fieldPositionNumber = 1,
				fieldType = "Numeric");

			Form.editFieldLabelMetal(fieldValue = "Age");

			Form.save();
		}

		task ("When The Form Is Filled In Both Languages") {
			MyTests.translateFormLabelFieldAndPublish(
				ageLabelFrench = "âge",
				textLabelFrench = "nom et prénom");

			FormsAdminNavigator.gotoPublishedForm();

			FormFields.editText(
				fieldName = "Full Name",
				fieldValue = "full name en");

			FormFields.editText(
				fieldName = "Age",
				fieldValue = 122);

			FormPortlet.submit();

			Form.submitAgain();

			FormPortletConfiguration.changeLanguage(
				currentLanguage = "en-US",
				newLanguage = "français-France");

			FormFields.editText(
				fieldName = "nom et prénom",
				fieldValue = "nom et prnom fr");

			FormFields.editText(
				fieldName = "âge",
				fieldValue = 122);

			FormPortlet.submit();

			Form.submitAgain();
		}

		task ("Then Validate That The Form Is Created") {
			Navigator.openURL();

			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Forms");

			FormsAdminNavigator.gotoViewEntries();

			LexiconEntry.viewEntryName(rowEntry = "nom et prnom fr");
		}
	}

}