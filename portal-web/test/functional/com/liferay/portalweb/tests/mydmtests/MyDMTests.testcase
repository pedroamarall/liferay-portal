@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document Description",
			dmDocumentTitle = "DM Document JPG",
			groupName = "Guest",
			mimeType = "image/jpeg",
			sourceFileName = "Document_4.jpg");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}

		ProductMenu.gotoPortlet(
			category = "Content & Data",
			portlet = "Documents and Media");

		Site.deleteAllCP();
	}

	@description = "Can Create a Documents and Media"
	@priority = "5"
	test CanCreateDM {
		ProductMenu.gotoPortlet(
			category = "Content & Data",
			portlet = "Documents and Media");

		DMDocument.addCP(
			dmDocumentDescription = "Document Description",
			dmDocumentFile = "Commerce_Black.jpg",
			dmDocumentTitle = "DM Document JPG Node1");

		ProductMenu.gotoHomePage();

		IsElementPresent(
			key_rowEntry = "DM Document JPG Node1",
			locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME");

		Alert.viewSuccessMessage();
	}

	@description = "Can Delete a Documents and Media"
	@priority = "5"
	test CanDeleteDM {
		task ("adding 1 file to have more than 2 in the test and so use the delete function") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Documents and Media");

			DMDocument.addCP(
				dmDocumentDescription = "New Description",
				dmDocumentFile = "Document_1.jpg",
				dmDocumentTitle = "New Document");
		}

		task ("Delete the first document") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Documents and Media");

			DMDocument.deleteCP(
				dmDocumentDescription = "DM Document Description",
				dmDocumentTitle = "DM Document JPG");

			ProductMenu.gotoHomePage();

			if (IsElementNotPresent(key_rowEntry = "New Document", locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME")) {
				ProductMenu.gotoHomePage();

				Alert.viewSuccessMessage();
			}
		}
	}
}