@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			PagesAdmin.tearDownCP();
		}
	}

	@description = "Set Screen size to custom and validate values"
	@priority = 5
	test SetScreenSizeAndValidateValues {
		task ("Given the simulation menu is opened") {
			MyMacros.OpenSimulationMenu();
		}

		task ("When the user sets the screen size") {
			MyMacros.ChangeToCustom();

			MyMacros.SetHeight(height = 1920);

			MyMacros.SetWidth(width = 1080);

			MyMacros.ApplyCustomSize();

			MyMacros.CloseSimulationMenu();

			MyMacros.OpenSimulationMenu();
		}

		task ("Then validate the values defined") {
			AssertTextEquals.assertPartialText(
				locator1 = "ControlMenuPreviewPanel#PREVIEW_APPLIED_CHANGES",
				value1 = "Applied");
		}
	}

	@description = "Access Portal Global Menu and validate CONFIGURATION string at Control Panel"
	@priority = 5
	test ValidateConfigurationStringAtControlPanel {
		task ("Given the applications menu is opened") {
			ApplicationsMenuHelper.openApplicationsMenu();
		}

		task ("When the user clicks on control panel") {
			ApplicationsMenu.gotoPanel(panel = "Control Panel");
		}

		task ("Then the page displays CONFIGURATION text") {
			AssertTextPresent(value1 = "CONFIGURATION");
		}
	}

}