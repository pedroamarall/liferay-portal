@component-name = "portal-simulation-menu"
definition {

	property testray.component.names = "Simulation";
	property testray.main.component.name = "Simulation";

	setUp {
		task ("Open new Instance of Liferay") {
			TestCase.setUpPortalInstance();
		}

		task ("Login") {
			User.firstLoginPG();
		}

		task ("Navigate to the Instance") {
			Navigator.openURL();
		}
	}

	tearDown {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");
	}

	@description = "Set Screen size to custom and validate values"
	@priority = 5
	test SetScreenSizeAndValidateValues {
		var width = 1080;
		var height = 1920;

		task ("Given The Simulation Panel") {
			MySimulatorMacro.GoToSimulation();
		}

		task ("When the custom size of the screen width:${width} and height:${height}") {
			MySimulatorMacro.EditSimulationSizeAndClose(
				height = ${height},
				width = ${width});
		}

		task ("Then the custom size should be declared on the panel alert") {
			MySimulatorMacro.ValidateSimulationValues(
				height = ${height},
				width = ${width});
		}
	}

	@description = "Access Portal Global Menu and validate CONFIGURATION string at Control Panel!"
	@priority = 5
	test ValidateConfigurationStringAtControlPanel {
		task ("Given the application Menu") {
			ApplicationsMenuHelper.openApplicationsMenu();
		}

		task ("When the application menu point to Control Panel") {
			ApplicationsMenu.gotoPanel(panel = "Control Panel");
		}

		task ("Then the configuration tab should exist") {
			AssertElementPresent(
				category = "Configuration",
				locator1 = "MyCustomPath#CONFIGURATION");
		}
	}

}