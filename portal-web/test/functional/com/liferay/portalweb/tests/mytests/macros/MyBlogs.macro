definition {

	macro addBlogEntry {
		BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");

		BlogsNavigator.gotoAddEntry();

		BlogsEntry.addEntryContent(
			entryContent = ${entryContent},
			entryTitle = ${entryTitle});

		PortletEntry.publish();
	}

	macro deleteBlogEntry {
		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Delete",
			rowEntry = "Blogs Entry Title");
	}

	macro editBlogEntry {
		LexiconEntry.gotoEntryMenuItem(
			menuItem = ${menuItem},
			rowEntry = ${rowEntry});

		BlogsEntry.editTitle(
			entryTitle = ${entryTitle},
			entryTitleEdit = ${entryTitleEdit});

		Button.clickPublish();
	}

	macro searchBlogEntry {
		BlogsEntry.searchCP(
			entrySearchTerm = ${entrySearchTerm},
			entryTitle = ${entrySearchTerm});
	}

}