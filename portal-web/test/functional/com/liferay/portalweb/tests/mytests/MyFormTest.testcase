@component-name = "portal-web-forms-and-data-lists"
definition {
    property testray.main.component.name = "Forms";

    setUp {
        TestCase.setUpPortalInstance();

        User.firstLoginPG();

        Navigator.openURL();
    }

    tearDown {
        User.logoutAndLoginPG(
            userLoginEmailAddress = "test@liferay.com",
            userLoginFullName = "Test Test");
    }

    @description = "Create a New form with Text feild and Numeric feild"
    @priority = "5"
    test AddFormWithTextFeildAndNumericFeild {
        
        task ("Given: create the form with the feilds") {
            FormsAdmin.addForm();

            Form.editName(formName = "Form 1");
            Form.editPageTitle(
                formPageName = "English",
                formTitleNumber = 1);
            Form.gotoAddField(
                fieldPositionNumber = 0,
                fieldType = "Text");
            Form.editFieldLabelMetal(fieldValue = "Full Name");
            Form.closeSidebar();
            Form.save();
            Form.gotoAddField(
                fieldPositionNumber = 1,
                fieldType = "Numeric");
            Form.editFieldLabelMetal(fieldValue = "Age");
            Form.save();
        }
        task ("When: translate the label fields") {
		    Form.addTranslation(localizedLanguage = "French (France)");
            Form.editPageTitle(
                formPageName = "Francais",
                formTitleNumber = 1);
            Click(
                key_name = "Full Name",
                locator1 = "FormFields#FIELD_TARGET_LABEL");

            FormFields.editText(
                fieldName = "Label",
                fieldValue = "nom et prénom"
            );
            Click(
                key_name = "Age",
                locator1 = "FormFields#FIELD_TARGET_LABEL");
            FormFields.editText(
                fieldName = "Label",
                fieldValue = "âge"
            );
            Form.save();
        }
        task ("Then: publish and validate the form") {
            Form.publishForm();
            FormsAdminNavigator.gotoPublishedForm();
            FormFields.editText(
                fieldName = "Full Name",
                fieldValue = "full name en");
            FormFields.editText(
                fieldName = "Age",
                fieldValue = "45645");
            FormPortlet.submit();
            Form.submitAgain();
            FormPortletConfiguration.changeLanguage(
                currentLanguage = "en-US",
                newLanguage = "français-France");
            FormFields.editText(
            fieldName = "nom et prénom",
                fieldValue = "nom et prenom fr");
            FormFields.editText(
            fieldName = "âge",
                fieldValue = "543656");
            FormPortlet.submit();
            Form.submitAgain();
            Navigator.openURL();
            ProductMenu.gotoPortlet(
                category = "Content & Data",
                portlet = "Forms");
            FormsAdminNavigator.gotoViewEntries();

        }
    }

}
 
   
   
   
   
