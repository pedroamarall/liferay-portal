@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		task ("Open new Instance of Liferay") {
			TestCase.setUpPortalInstance();
		}

		task ("Login") {
			User.firstLoginPG();
		}

		task ("Navigate to the Instance") {
			Navigator.openURL();
		}
	}

	tearDown {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");
	}

	@description = "Verify if Form Translation Can be added and exist"
	@priority = 5
	test CreateFormAddTranslationThenVerifyIfTranslationExist {
		task ("Given This new form created") {
			FormsAdmin.addForm();

			Form.editName(formName = "United States");

			Form.editDescription(formDescription = "This Form for a testcase in English.");

			Form.editPageTitle(
				formPageName = "English",
				formTitleNumber = 1);

			Form.gotoAddField(
				fieldPositionNumber = 0,
				fieldType = "Text");

			FormFields.editText(
				fieldName = "Label",
				fieldValue = "Full Name");

			Form.save();

			Form.gotoAddField(
				fieldPositionNumber = 1,
				fieldType = "Numeric");

			FormFields.editText(
				fieldName = "Label",
				fieldValue = "Age");

			Form.save();
		}

		task ("When I add translator, edit the fields and publish the form") {
			Form.addTranslation(localizedLanguage = "French (France)");

			Form.editName(formName = "France");

			Form.editDescription(formDescription = "Cet Formulaire est pour un test en Francais.");

			Form.editPageTitle(
				formPageName = "Francais",
				formTitleNumber = 1);

			Click(
				key_fieldName = "Full Name",
				locator1 = "FormFields#TEXT_FIELD");

			FormFields.editText(
				fieldName = "Label",
				fieldValue = "Nom et prénom");

			Click(
				key_fieldName = "Age",
				locator1 = "FormFields#TEXT_FIELD");

			FormFields.editText(
				fieldName = "Label",
				fieldValue = "âge");

			Form.save();

			Form.publishForm();
		}

		task ("Then It should verify if the translation exists") {
			FormsAdminNavigator.gotoPreviewForm();

			Navigator.selectSpecificWindow(windowTitle = "Form - Forms");

			FormPortletConfiguration.viewTranslationLanguage(language = "français-France");
		}
	}

}