<html>
<head>
<title>PanelTest</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">PanelTest</td></tr>
</thead>

<tbody>
<tr>
	<td>MENU_BUTTON</td>
	<td>//*[contains(@class, 'dropdown-toggle lfr-portal-tooltip btn btn-monospaced btn-sm btn-unstyled')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTROL_PANEL_BUTTON</td>
	<td>//li[contains(@id, '_com_liferay_product_navigation_applications_menu_web_internal_portlet_ProductNavigationApplicationsMenuPortlet_tab_2')]</td>
	<td></td>
</tr>
<tr>
	<td>CONTROL_PANEL_CONFIG_SECTION</td>
	<td>//h2[contains(@id, 'nav_control_panel.configuration')]</td>
	<td></td>
</tr>
<tr>
	<td>SIMULATION_MENU_BUTTON</td>
	<td>//*[@id="_com_liferay_product_navigation_simulation_web_portlet_SimulationPortlet_simulationToggleId"]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_BUTTON</td>
	<td>//*[@id="_com_liferay_product_navigation_simulation_web_portlet_SimulationPortlet_simulationDeviceContainer"]/div/div/button[5]</td>
	<td></td>
</tr>
<tr>
	<td>WIDTH_INPUT</td>
	<td>//*[@id="_com_liferay_product_navigation_simulation_web_portlet_SimulationPortlet_width"]</td>
	<td></td>
</tr>
<tr>
	<td>HEIGHT_INPUT</td>
	<td>//*[@id="_com_liferay_product_navigation_simulation_web_portlet_SimulationPortlet_height"]</td>
	<td></td>
</tr>
<tr>
	<td>APPLY_CUSTOM_BUTTON</td>
	<td>//*[@id="_com_liferay_product_navigation_simulation_web_portlet_SimulationPortlet_customSizeSelector"]/button</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>