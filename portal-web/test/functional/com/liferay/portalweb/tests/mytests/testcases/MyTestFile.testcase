@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");
	}

	@description = "Set Screen size to custom and validate values"
	@priority = 5
	test SetScreenSizeAndValidateValues {
		task ("Given Simulation Menu") {
			Click(locator1 = "PanelTest#SIMULATION_MENU_BUTTON");
		}

		task ("And custom size option") {
			Click(locator1 = "PanelTest#CUSTOM_BUTTON");
		}

		task ("And Height and Width are set") {
			TripleClick(locator1 = "PanelTest#WIDTH_INPUT");

			Type.sendKeys(
				locator1 = "PanelTest#WIDTH_INPUT",
				value1 = 1080);

			TripleClick(locator1 = "PanelTest#HEIGHT_INPUT");

			Type.sendKeys(
				locator1 = "PanelTest#HEIGHT_INPUT",
				value1 = 1920);
		}

		task ("When apply new size") {
			Click(locator1 = "PanelTest#APPLY_CUSTOM_BUTTON");
		}

		task ("Then validate if sizes are applied") {
			AssertElementPresent(locator1 = "PanelTest#CUSTOM_SIZE_APPLIED_ALERT_INFO");
		}
	}

	@description = "Access Portal Global Menu and validate CONFIGURATION string at Control Panel"
	@priority = 5
	test ValidateSectionDisplay {
		task ("Given Application Menu") {
			Click(locator1 = "PanelTest#MENU_BUTTON");
		}

		task ("When open Conrol Panel") {
			Click(locator1 = "PanelTest#CONTROL_PANEL_BUTTON");
		}

		task ("Then assert the existence of configuration section") {
			AssertTextEquals.assertText(
				locator1 = "PanelTest#CONTROL_PANEL_CONFIG_SECTION",
				value1 = "CONFIGURATION");
		}
	}

}