@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			PagesAdmin.tearDownCP();
		}
	}

	@description = "Publish the Form > Navigate to the published Form and validate the title translations when changing the form language on the page"
	@priority = 5
	test PublishFormAndValidateTitleTranslations {
		task ("Given the form was added and edited and saved") {
			MyMacros.createFormAndEditAndSave();
		}

		task ("When the user adds the translation") {
			Form.addTranslation(localizedLanguage = "Arabic (Saudi Arabia)");

			FormViewBuilder.editFieldLabel(
				fieldLabel = "Full Name",
				label = "الاسم الكامل");

			FormViewBuilder.editFieldLabel(
				fieldLabel = "Age",
				label = "العمر");

			Form.closeSidebar();

			Form.save();

			Form.publishForm();
		}

		task ("And submit the created form in both languages") {
			MyMacros.fillFormInFrench();

			FormPortlet.submit();

			Form.submitAgain();

			MyMacros.fillFormInArabic();

			FormPortlet.clickSubmit();

			AssertElementPresent(locator1 = "Message#SUCCESS");
		}

		task ("Then validate translations") {
			MyMacros.goToViewEntriesForm();

			AssertTextPresent(value1 = "Ilyass Hossni");

			AssertTextPresent(value1 = 21);

			AssertTextPresent(value1 = "أحمد بن محمد الحمداني الجيلالي آل سعود");
		}
	}

}