@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	var dmDocumentTitle = "DM 1";
	var fileName = "really-youness.png";

	setUp {
		task ("Open new Instance of Liferay") {
			TestCase.setUpPortalInstance();
		}

		task ("Login") {
			User.firstLoginPG();
		}

		task ("Add nessecary files for the testcases to work") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = ${dmDocumentTitle},
				groupName = "Guest",
				mimeType = "image/png",
				sourceFileName = ${fileName});

			JSONDocument.addFileWithUploadedFile(
				dmDocumentTitle = "DM Document Title 2",
				groupName = "Guest",
				mimeType = "image/png",
				sourceFileName = "really-youness 2.png");
		}

		task ("Navigate to the Instance") {
			Navigator.openURL();
		}

		// Since This is a repeated task I will put the given of all testcases in the Setup to avoid repition

		task ("Given The portlet DM page") {
			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");
		}
	}

	tearDown {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");
	}

	@description = "Upload File to DM"
	@priority = 5
	test CanCreateDM {

		// Just Remember the given task is on the setup level.

		task ("When The user publish The Document and (Upload the file)") {
			DMDocument.addCP(
				dmDocumentDescription = "DM Document Description",
				dmDocumentFile = "text.txt",
				dmDocumentTitle = "New Added Document");
		}

		task ("Then the addded document should be displayed on the list") {
			AssertElementPresent(
				key_dmDocumentTitle = "New Added Document",
				locator1 = "DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_TITLE");
		}
	}

	@description = "Delete File From DM"
	@priority = 5
	test CanDeleteDM {

		// Just Remember the given task is on the setup level.

		task ("When the User delete a document") {
			DMDocument.deleteCP(dmDocumentTitle = ${dmDocumentTitle});
		}

		task ("Then the file delete should not exist and second file should exist") {
			AssertElementNotPresent(
				key_dmDocumentTitle = ${dmDocumentTitle},
				locator1 = "DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_TITLE");

			AssertElementPresent(
				key_dmDocumentTitle = "DM Document Title 2",
				locator1 = "DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_TITLE");
		}
	}

	@description = "Access Portal Global Menu and validate CONFIGURATION string at Control Panel!"
	@priority = 5
	test CanDownloadDM {

		// Just Remember the given task is on the setup level.

		task ("When the user download document from DMTest1") {
			DMDocument.downloadCP(
				dmDocumentSize = "9 KB",
				dmDocumentTitle = ${dmDocumentTitle});
		}

		task ("Then that download file must be the only who exist in local disk") {
			DMDocument.assertFileNameFromTempFolder(fileName = ${fileName});

			DMDocument.assertNoFileNameFromTempFolder(fileName = "really-youness 2.png");
		}
	}

	@description = "Edit File in DM"
	@priority = 5
	test CanEditDM {

		// Just Remember the given task is on the setup level.

		task ("When user edit the document, uploaded a new file, and publish") {
			DMDocument.editCP(
				dmDocumentFileEdit = "really-youness-edit.png",
				dmDocumentFileNameEdit = "really-youness-edit.png",
				dmDocumentTitle = ${dmDocumentTitle},
				dmDocumentTitleEdit = "Edited Title");
		}

		task ("Then edited document must apply and exist") {
			AssertElementPresent(
				key_dmDocumentTitle = "Edited Title",
				locator1 = "DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_TITLE");
		}
	}

}