@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		User.logoutPG();
	}

	@description = "Set Screen size to custom and validate values"
	@priority = 5
	test SetScreenSizeAndValidateValues {
		task ("Given The Simulation menu is open") {
			PoshiExercises.openSimulationMenu();
		}

		task ("And Select the screen size for the customized option") {
			PoshiExercises.chooseCustomDevice();
		}

		task ("When Set Width to 1080 px") {
			PoshiExercises.setCustomWidth(customWidth = 1080);
		}

		task ("And Set Height to 1920 px") {
			PoshiExercises.setCustomHeight(customHeight = 1920);
		}

		task ("Then Confirm and close the Simulation menu") {
			PoshiExercises.confirmCustomDeviceSize();

			PoshiExercises.exitSimulationMenu();
		}

		task ("And Open the Simulation menu again") {
			PoshiExercises.openSimulationMenu();
		}

		task ("And Validate that the values defined in step 4 persisted") {
			AssertTextEquals.assertPartialText(
				locator1 = "ControlMenuPreviewPanel#PREVIEW_APPLIED_CHANGES",
				value1 = "Applied");

			PoshiExercises.exitSimulationMenu();
		}
	}

}