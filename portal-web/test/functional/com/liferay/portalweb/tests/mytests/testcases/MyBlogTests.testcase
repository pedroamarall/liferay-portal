@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		task ("Given the Blogs Portlet is added to the page") {
			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");
		}

		task ("When the user adds a Blog Entry") {
			Blogs.addEntry(
				entryContent = "Blogs",
				entryTitle = "Test");
		}

		task ("Then the Blog Entry should display on the page") {
			Blogs.viewEntryPresent(entryTitle = "Test");
		}
	}

	@description = "Can Delete a Blog"
	@priority = 5
	test CanDeleteBlog {
		task ("Given the Blogs Portlet is added to the page And Blog Entry exists ") {
			MyBlogs.Addblog();
		}

		task ("Then the Blogs Portlet is deleted from the page") {
			LexiconEntry.gotoEntryMenuItem(
				menuItem = "Delete",
				rowEntry = "Test");
		}
	}

	@description = "Can edit a Blog"
	@priority = 5
	test CanEditBlog {
		task ("Given the Blogs Portlet is added to the page And Blog Entry exists ") {
			MyBlogs.Addblog();
		}

		task ("When the User edits the blog Entry") {
			LexiconEntry.gotoEntryMenuItem(
				menuItem = "Edit",
				rowEntry = "Test");

			BlogsEntry.editTitle(
				entryTitle = "Test",
				entryTitleEdit = "New title");
		}

		task ("Then the Blog Entry should be edited and published") {
			Button.clickPublish();
		}
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSearchBlogs {
		task ("Given the Blogs Portlet is added to the page And Blog Entry exists ") {
			MyBlogs.Addblog();
		}

		task ("then user searched for blog entry ") {
			BlogsEntry.searchCP(
				entrySearchTerm = "Test",
				entryTitle = "Test");
		}
	}

}