@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		task ("Given the blog creation") {
			MyBlogs.addBlogEntry(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry Title");
		}

		task ("Then validate the blog is found") {
			AssertElementPresent(
				key_entryTitle = "Blogs Entry Title",
				key_tagName = "Blogs Entry Title",
				locator1 = "BlogsEntry#TAG");
		}
	}

	@description = "Can Delete a Blog"
	@priority = 5
	test CanDeleteBlog {
		task ("Given the blog already created") {
			MyBlogs.addBlogEntry(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry Title");
		}

		task ("When delete the blog entry") {
			MyBlogs.deleteBlogEntry();
		}

		task ("Then validate the blog is found") {
			AssertElementNotPresent(
				key_entryTitle = "Blogs Entry Title",
				key_tagName = "Blogs Entry Title",
				locator1 = "BlogsEntry#TAG");
		}
	}

	@description = "Can Edit a Blog"
	@priority = 5
	test CanEditBlog {
		task ("Given the blog already created") {
			MyBlogs.addBlogEntry(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry Title");
		}

		task ("When edit the blog title") {
			MyBlogs.editBlogEntry(
				entryTitle = "Blogs Entry Title",
				entryTitleEdit = "New title",
				menuItem = "Edit",
				rowEntry = "Blogs Entry Title");
		}

		task ("Then validate the blog is found") {
			AssertElementPresent(
				key_entryTitle = "New title",
				key_tagName = "New title",
				locator1 = "BlogsEntry#TAG");
		}
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSearchBlogs {
		task ("Given the blog already created") {
			MyBlogs.addBlogEntry(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry Title");
		}

		task ("When search for the blog entry and validate its existensse") {
			MyBlogs.searchBlogEntry(
				entrySearchTerm = "Blogs",
				entryTitle = "Blogs Entry Title");
		}

		task ("Then validate the blog is found") {
			AssertElementPresent(
				key_entryTitle = "Blogs Entry Title",
				key_tagName = "Blogs Entry Title",
				locator1 = "BlogsEntry#TAG");
		}
	}

}