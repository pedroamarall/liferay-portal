@component-name = "portal-lima"
definition {
    property testray.main.component.name = "Blogs";

    setUp {
        TestCase.setUpPortalInstance();

        User.firstLoginPG();

        Navigator.openURL();
    }

     tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
     }

    @description = "Can Create a Blog"
    @priority = "5"
    test CanCreateBlog {
        MyBlogs.addBlogEntry();
    }

    @description = "Can Edit a Blog"
    @priority = "5"
    test CanEditBlog {
        
        task ("Given the blog already created") {
            MyBlogs.addBlogEntry();
        }
        
        task ("Then edit the blog title") {
            MyBlogs.editBlogEntry();
        }
        
       
    }

    @description = "Can Delete a Blog"
    @priority = "5"
    test CanDeleteBlog {
        
        task ("Given the blog already created") {
            MyBlogs.addBlogEntry();
        }
        
        task ("Then delete the blog entry") {
            MyBlogs.deleteBlogEntry();
        }

        
    }

    @description = "Can Search Blogs"
    @priority = "5"
    test CanSearchBlogs {
        
        task ("Given the blog already created") {
            MyBlogs.addBlogEntry();
        }
        
        task ("Then search for the blog entry and validate its existensse") {
            MyBlogs.searchBlogEntry();
        }
        

    }

}
