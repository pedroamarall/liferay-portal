definition {

	macro AddFields {
		Form.gotoAddField(fieldType = ${fieldType1});

		Form.editFieldLabelMetal(fieldValue = ${fieldValue1});

		Form.save();

		Form.gotoAddField(fieldType = ${fieldType2});

		Form.editFieldLabelMetal(fieldValue = ${fieldValue2});

		Form.save();
	}

	macro ChangeFields {
		FormViewBuilder.clickFieldLabel(fieldLabel = ${fieldLabel1});

		Form.editElementSetFieldLabel(fieldValue = ${fieldValue1});

		FormViewBuilder.clickFieldLabel(fieldLabel = ${fieldLabel2});

		Form.editElementSetFieldLabel(fieldValue = ${fieldValue2});

		Form.save();

		Form.publishForm();
	}

	macro ClickControlPanel {
		Click(locator1 = "FileTest#CLICK_CTP");
	}

	macro CreateBlogs {
		Blogs.addEntry(
			entryContent = ${entryContent},
			entryTitle = ${entryTitle});
	}

	macro DeleteBlog {
		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Delete",
			rowEntry = ${rowEntry});
	}

	macro EditBlogs {
		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Edit",
			rowEntry = ${rowEntry});

		BlogsEntry.editTitle(
			entryTitle = ${entryTitle},
			entryTitleEdit = ${entryTitleEdit});

		Button.clickPublish();
	}

	macro FillTheForm {
		FormFields.viewTextField(
			fieldLabel = ${fieldLabel1},
			fieldName = ${fieldName1});

		FormFields.editText(
			fieldName = ${fieldName1},
			fieldValue = ${fieldValue1});

		FormFields.viewTextField(
			fieldLabel = ${fieldLabel2},
			fieldName = ${fieldName2});

		FormFields.editText(
			fieldName = ${fieldName2},
			fieldValue = ${fieldValue2});

		FormPortlet.submitSuccessfully();

		Form.submitAgain();
	}

	macro FillTheFormWithNewLanguage {
		FormFields.viewTextField(
			fieldLabel = ${fieldLabel1},
			fieldName = ${fieldName1});

		FormFields.editText(
			fieldName = ${fieldName1},
			fieldValue = ${fieldValue1});

		FormFields.viewTextField(
			fieldLabel = ${fieldLabel2},
			fieldName = ${fieldName2});

		FormFields.editText(
			fieldName = ${fieldName2},
			fieldValue = ${fieldValue2});

		FormPortlet.submitSuccessfully();

		Form.submitAgain();
	}

	macro GotoSimulation {
		Click(locator1 = "FileTest#CLICK_SIMULATION");

		Click(locator1 = "FileTest#CLICK_CUSTOM");
	}

	macro typeTheheight {
		TripleClick(locator1 = "FileTest#INPUT_WIDTH");

		Type.sendKeys(
			locator1 = "FileTest#INPUT_WIDTH",
			value1 = 1080);
	}

	macro typeTheweidth {
		TripleClick(locator1 = "FileTest#INPUT_HEIGHT");

		Type.sendKeys(
			locator1 = "FileTest#INPUT_HEIGHT",
			value1 = 1920);
	}

	macro VerifyCONF {
		AssertTextEquals.assertText(
			locator1 = "FileTest#CHECK_CONF",
			value1 = ${item});
	}

	macro VerifyTheResultForm {
		FormsAdminNavigator.gotoViewEntries();

		LexiconEntry.viewEntryName(rowEntry = ${rowEntry});

		LexiconEntry.viewEntryContent(
			rowAny = ${rowAny},
			rowEntry =${rowEntry2});
	}

}