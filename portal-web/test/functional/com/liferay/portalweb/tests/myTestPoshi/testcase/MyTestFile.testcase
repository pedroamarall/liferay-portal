@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		task ("Given Go to Blogs Part") {
			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");
		}

		task ("Then created new Blog") {
			TestTraining.CreateBlogs(
				entryContent = "This is Blog Content",
				entryTitle = "This is Title");
		}
	}

	@description = "Can Delete a Blog"
	@priority = 5
	test CanDeleteBlog {
		task ("Given Go to Blogs Part") {
			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");
		}

		task ("When created new Blog") {
			TestTraining.CreateBlogs(
				entryContent = "This is Blog Content",
				entryTitle = "This is Title");
		}

		task ("Then delete the Blog contain this title") {
			TestTraining.DeleteBlog(rowEntry = "This is Title");
		}
	}

	@description = "Can Edit a Blog"
	@priority = 5
	test CanEditBlog {
		task ("Given Go to Blogs Part") {
			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");
		}

		task ("Given created new Blog") {
			TestTraining.CreateBlogs(
				entryContent = "This is Blog Content",
				entryTitle = "This is Title");
		}

		task ("Then Edit the Blog") {
			TestTraining.EditBlogs(
				entryTitle = "This is Title",
				entryTitleEdit = "This Title is Edited");
		}
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSearchBlogs {
		task ("Given Go to Blogs Part") {
			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");
		}

		task ("When created new Blog") {
			TestTraining.CreateBlogs(
				entryContent = "This is Blog Content",
				entryTitle = "This is Title");
		}

		task ("Then can search for blogs") {
			BlogsEntry.searchCP(
				entryContent = "Blogs Content",
				entrySearchTerm = "This is ",
				entryTitle = "This is Title");
		}
	}

	@description = "Add some fields in form part"
	@priority = 5
	test CreateForm {
		task ("GIVEN Go to Form") {
			ApplicationsMenuHelper.openApplicationsMenu();
		}

		task ("When Go to add new form") {
			FormsAdmin.addForm();
		}

		task ("And Go add some fields full name and age") {
			TestTraining.AddFields();
		}

		task ("And add translator") {
			Form.addTranslation(localizedLanguage = "French (France)");
		}

		task ("And change some fields to frensh names") {
			TestTraining.ChangeFields();
		}

		task ("And go to publish form") {
			FormsAdminNavigator.gotoPublishedForm();
		}

		task ("And fill out the form that we already create") {
			TestTraining.FillTheForm();
		}

		task ("And change the language") {
			FormPortletConfiguration.changeLanguage(
				currentLanguage = "en-US",
				newLanguage = "français-France");
		}

		task ("And fill the inputs with new language") {
			TestTraining.FillTheFormWithNewLanguage();
		}

		task ("And Navigate to the form page") {
			Navigator.openURL();

			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Forms");
		}

		task ("Then verify the results") {
			TestTraining.VerifyTheResultForm();
		}
	}

	@description = "Set Screen size to custom and validate values"
	@priority = 5
	test SetScreenSizeAndValidateValues {
		TestTraining.GotoSimulation();

		TestTraining.typeTheheight();

		TestTraining.typeTheweidth();
	}

	@description = "Access Portal Global Menu and validate CONFIGURATION string at Control Panel"
	@priority = 5
	test ValidateConfigurationStringAtControlPanel {
		task ("GIVEN Go to menu") {
			TestTraining.ClickMenu();
		}

		task ("WHEN Control Panel ") {
			TestTraining.ClickControlPanel();
		}

		task ("then check if CONFIGURATION its exist or not") {
			TestTraining.VerifyCONF(item = "CONFIGURATION");
		}
	}

}