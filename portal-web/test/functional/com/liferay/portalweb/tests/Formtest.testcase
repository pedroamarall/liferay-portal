@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		task ("Open new Instance of Liferay") {
			TestCase.setUpPortalInstance();
		}

		task ("Login") {
			User.firstLoginPG();
		}

		task ("Navigate to the Instance") {
			Navigator.openURL();
		}
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	test CreateFormWithTextFeildAndNumericFeild {
		task ("Given a Form with a text field and a Numeric field") {
			FormsAdmin.addForm();

			Form.editName(formName = "Untitled Form");

			Form.gotoAddField(fieldType = "Text");

			Form.editFieldLabelMetal(fieldValue = "Full Name");

			Form.save();

			Form.gotoAddField(fieldType = "Numeric");

			Form.editFieldLabelMetal(fieldValue = "Age");

			Form.save();
		}

		task ("and translates field Titles into english and french") {
			Form.addTranslation(localizedLanguage = "French (France)");

			FormViewBuilder.editFieldLabel(
				fieldLabel = "Full Name",
				label = "nom et prénom");

			FormViewBuilder.editFieldLabel(
				fieldLabel = "Age",
				label = "âge");

			Form.save();

			Form.publishForm();
		}

		task ("When the form published and validated of translation") {
			FormsAdminNavigator.gotoPublishedForm();

			FormFields.viewTextField(
				fieldLabel = "Full Name",
				fieldName = "Text");

			FormFields.editText(
				fieldName = "Text",
				fieldValue = "Samireddebbarhi");

			FormFields.viewTextField(
				fieldLabel = "Age",
				fieldName = "Numeric");

			FormFields.editText(
				fieldName = "Numeric",
				fieldValue = 23);

			FormPortlet.clickSubmit();

			Form.submitAgain();
		}

		task ("And Check and Validate the submited content") {
			FormPortletConfiguration.changeLanguage(
				currentLanguage = "en-US",
				newLanguage = "français-France");

			FormFields.viewTextField(
				fieldLabel = "nom et prénom",
				fieldName = "Text");

			FormFields.editText(
				fieldName = "Text",
				fieldValue = "Samireddebbarhi");

			FormFields.viewTextField(
				fieldLabel = "âge",
				fieldName = "Numeric");

			FormFields.editText(
				fieldName = "Numeric",
				fieldValue = 23);

			FormPortlet.submitSuccessfully();
		}

		task ("Then validate the Forms is created succefully") {
			Navigator.openURL();

			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Forms");

			FormsAdminNavigator.gotoViewEntries();

			LexiconEntry.viewEntryName(rowEntry = "Samireddebbarhi");
		}
	}

}