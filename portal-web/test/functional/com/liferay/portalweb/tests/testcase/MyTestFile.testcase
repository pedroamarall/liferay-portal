@component-name = "portal-simulation-menu"
definition {

	property testray.component.names = "Simulation";
	property testray.main.component.name = "Simulation";

	setUp {
		task ("Open new Instance of Liferay") {
			TestCase.setUpPortalInstance();
		}

		task ("Login") {
			User.firstLoginPG();
		}

		task ("Navigate to the Instance") {
			Navigator.openURL();
		}
	}

	tearDown {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");
	}

	@description = "Set Screen size to custom and validate values"
	@priority = 5
	test SetScreenSizeAndValidateValues {
		task ("Given Open the Simulation menu") {
			Click(locator1 = "ControlMenu#SIMULATION");

			Click(
				key_deviceType = "Custom",
				locator1 = "ControlMenuPreviewPanel#PREVIEW_DATA_DEVICE_BUTTON");
		}

		task ("When Select the screen size for the customized option for Set Height to 1920 px and Width to 1080 px") {
			Testex.Previewsize();

			Click(locator1 = "Testex#APPLY_CUSTOM_SIZE");
		}

		task ("And Close the Simulation menu ") {
			Click(locator1 = "Testex#CLOSE_SIMULATION_MENU");
		}

		task ("Then Check the values defined on Height and Width") {
			Click(locator1 = "ControlMenu#SIMULATION");

			Click(
				key_deviceType = "Custom",
				locator1 = "ControlMenuPreviewPanel#PREVIEW_DATA_DEVICE_BUTTON");

			AssertTextEquals(
				locator1 = "Testex#ALERTE",
				value1 = "Custom Size 1920x1080 Applied");
		}
	}

	@description = "Access Portal Global Menu and validate CONFIGURATION string at Control Panel"
	@priority = 5
	test ValidateConfigurationStringAtControlPanel {
		task ("Given Open the Application Menu ") {
			ApplicationsMenuHelper.openApplicationsMenu();
		}

		task ("When Switch to Control Panel") {
			ApplicationsMenu.gotoPanel(
				category = "Configuration",
				panel = "Control Panel");
		}

		task ("Then Validate that the CONFIGURATION section is displayed ") {
			AssertElementPresent(locator1 = "Testex#SECTION_CONFIGURATION");
		}
	}

}