@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");
	}

	@description = "Create a New form with Text feild and Numeric feild"
	@priority = 5
	test Createform {
		task ("Given:Create a Form with a Text field and a Numeric field ") {
			FormsAdmin.addForm();

			Form.editName(formName = "form ENG");

			Form.editDescription(formDescription = "form  ENG");

			Form.editPageTitle(
				formPageName = "Created Form EN",
				formTitleNumber = 1);

			Form.gotoAddField(
				fieldPositionNumber = 0,
				fieldType = "Text");

			Form.editFieldLabelMetal(fieldValue = "Full Name");

			Form.closeSidebar();

			Form.save();

			Form.gotoAddField(
				fieldPositionNumber = 1,
				fieldType = "Numeric");

			Form.editFieldLabelMetal(fieldValue = "Age");

			Form.save();
		}

		task ("Then: Translates field titles into English and French") {
			Form.addTranslation(localizedLanguage = "French (France)");

			Form.editName(formName = "form frc ");

			Form.editDescription(formDescription = "form en frc");

			Form.editPageTitle(
				formPageName = "Creation formulaire en frc",
				formTitleNumber = 1);

			Click(
				key_fieldName = "Full Name",
				locator1 = "FormFields#TEXT_FIELD");

			Form.editFieldLabelMetal(fieldValue = "Nom Prenom");

			Click(
				key_fieldName = "Age",
				locator1 = "FormFields#TEXT_FIELD");

			Form.editFieldLabelMetal(fieldValue = "Age");

			Form.save();
		}

		task ("And: Publish the Form for validate the submitted content ") {
			Form.publishForm();

			FormsAdminNavigator.gotoPublishedForm();

			FormFields.editText(
				fieldName = "Full Name",
				fieldValue = "Adnan");

			FormFields.editText(
				fieldName = "Age",
				fieldValue = 22);

			FormPortlet.submit();

			Form.submitAgain();

			FormPortletConfiguration.changeLanguage(
				currentLanguage = "en-US",
				newLanguage = "français-France");

			FormFields.editText(
				fieldName = "Nom Prenom",
				fieldValue = "Adnan");

			FormFields.editText(
				fieldName = "Age",
				fieldValue = 22);

			FormPortlet.submit();

			Form.submitAgain();

			Navigator.openURL();

			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Forms");

			FormsAdminNavigator.gotoViewEntries();
		}
	}

}