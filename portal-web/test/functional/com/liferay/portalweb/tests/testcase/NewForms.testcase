@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		task ("Open new Instance of Liferay") {
			TestCase.setUpPortalInstance();
		}

		task ("Login") {
			User.firstLoginPG();
		}

		task ("Navigate to the Instance") {
			Navigator.openURL();
		}
	}

	tearDown {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");
	}

	@description = "Create a New form with Translation"
	@priority = 5
	test CanICreateFormWithTranslation {
		task ("Given open Menu ") {
			ApplicationsMenuHelper.openApplicationsMenu();
		}

		task ("When add new form") {
			FormsAdmin.addForm();
		}

		task ("And add some fields full name and age") {
			Testex.Addfieldsform(
				fieldPositionNumber = 0,
				fieldPositionNumber2 = 1,
				fieldType1 = "Text",
				fieldType2 = "Numeric",
				fieldValue1 = "Full Name",
				fieldValue2 = "Age",
				formDescription = "form ENG",
				formName = "form ENG",
				formPageName = "Created Form EN",
				formTitleNumber = 1);
		}

		task ("And add translator ") {
			Form.addTranslation(localizedLanguage = "French (France)");
		}

		task ("And translate label to french") {
			Testex.Changefieldsform(
				fieldValue1 = "Nom Prenom",
				fieldValue2 = "Age",
				formDescription = "form en frc",
				formName = "form frc",
				formPageName = "Creation formulaire en frc",
				formTitleNumber = 1);
		}

		task ("And Publish Form ") {
			Form.publishForm();

			FormsAdminNavigator.gotoPublishedForm();
		}

		task ("And fill the form in eng") {
			Testex.fillform(
				fieldName1 = "Full Name",
				fieldName2 = "Age",
				fieldValue1 = "Adnan",
				fieldValue2 = 22);
		}

		task ("And Change the language in french") {
			FormPortletConfiguration.changeLanguage(
				currentLanguage = "en-US",
				newLanguage = "français-France");
		}

		task ("And fill the form in french") {
			Testex.fillformfr(
				fieldName1 = "Nom Prenom",
				fieldName2 = "Age",
				fieldValue1 = "Adnan",
				fieldValue2 = 22);
		}

		FormFields.editText(
			fieldName = "Nom Prenom",
			fieldValue = "Adnan");

		FormFields.editText(
			fieldName = "Age",
			fieldValue = 22);

		FormPortlet.submit();

		Form.submitAgain();

		task ("And Navigate to the Form page") {
			Navigator.openURL();

			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Forms");
		}

		task ("Then Check the form is created") {
			Testex.CheckForm(
				rowAny = "Adnan",
				rowEntry = "Adnan",
				rowEntry2 = "Adnan");
		}
	}

}