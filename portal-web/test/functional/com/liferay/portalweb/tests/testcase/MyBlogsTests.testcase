@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");

		Blogs.addEntry(
			entryContent = "Blogs Content Can Creating test 1",
			entrySubtitle = "test1 Can Creating Subtittle",
			entryTitle = "Blogs Title Can Creating");

		Blogs.viewEntryNotPresent(entryTitle = "Blogs Title Can Creating");
	}

	@description = "Can Delete a Blog"
	@priority = 5
	test CanDeleteBlog {
		BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");

		Blogs.addEntry(
			entryContent = "Blogs Content Can Creating test 1",
			entrySubtitle = "test1 Can Creating Subtittle",
			entryTitle = "Blogs Title Can Creating");

		Blogs.addEntry(
			entryContent = "Blogs Content Can Creating test 2",
			entrySubtitle = "test2 Can Creating Subtittle",
			entryTitle = "Test2");

		//Pause(locator1 = "30000");
		//Click(locator1 ="BlogsEd#DELETECHOICEE");
		//Click(locator1 ="BlogsEd#DELETE");

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Delete",
			rowEntry = "Blogs Title Can Creating");
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanEditBlog {
		BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");

		Blogs.addEntry(
			entryContent = "Blogs Content Can Creating test 1",
			entrySubtitle = "test1 Can Creating Subtittle",
			entryTitle = "Blogs Title Can Creating");

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Edit",
			rowEntry = "Blogs Title Can Creating");

		BlogsEntry.editEntryContent(
			entryTitle = "Blogs Title Can Creating",
			entryTitleEdit = "aaaaaaaaaaa");
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSearchBlogs {
		BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");

		Blogs.addEntry(
			entryContent = "Blogs Content Can Creating test 1",
			entrySubtitle = "test1 Can Creating Subtittle",
			entryTitle = "Blogs Title Can Creating");

		Blogs.addEntry(
			entryContent = "hhhhhhhhhh",
			entrySubtitle = "hhhhhh",
			entryTitle = "hhhhh");

		BlogsEntry.searchCP(
			entryContent = "Blogs Content Can Creating test 1",
			entrySearchTerm = "Blogs Title Can Creating",
			entryTitle = "Blogs Title Can Creating");

		//SearchResultPortlet.viewSearchResults(
		//searchAssetTitle = "Blogs Title Can Creating",
		//searchAssetType = "Blogs Entry",
		//searchTerm = "Blogs Title Can Creating");

	}

}