@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		task ("Given: the Blogs Portlet is added to the page") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");
		}

		task ("When: the user adds a Blog Entry") {
			JSONBlog.addEntry(
				entryContent = "My first Blog",
				entryTitle = "My first Blog");
			Refresh();
		}

		task ("Then: the Blog Entry should display on the page") {
			AssertElementPresent(
				key_entryTitle = "My first Blog",
				key_tagName = "My first Blog",
				locator1 = "BlogsEntry#TAG");

		}
	}


	@description = "Can Delete a Blog"
	@priority = 5
	test CanDeleteBlog {
		task ("Given : Create Blog entry") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");
			JSONBlog.addEntry(
				entryContent = "Blogs Entry Content will be deleted",
				entryTitle = "Blogs Entry Title will be deleted");
            Refresh();
		}
		task ("When :delete the blog entry") {
			Testex.deleteBlogEntry();
		}
		task ("Then: Check that the blog has been delete") {
			AssertElementNotPresent(
				key_entryTitle = "Blogs Entry Title will be deleted",
				key_tagName = "Blogs Entry Title will be deleted",
				locator1 = "BlogsEntry#TAG");
		}

	}

	@description = " Can Edit a Blog"
	@priority = 5
	test CanEditBlog {
		task ("Given :Create Blog entry") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");
			JSONBlog.addEntry(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry Title");
			Refresh();
		}
		task ("When :Edit the blog title") {
			Testex.editBlogEntry();
		}
		task ("Then: Check that the blog has been edited") {
			AssertElementNotPresent(
				key_entryTitle = "Blogs Entry Title",
				key_tagName = "Blogs Entry Title",
				locator1 = "BlogsEntry#TAG");

	}
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSearchBlogs {
		task ("Given :Create Blog entry") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");
			JSONBlog.addEntry(
				entryContent = "Blogs Entry first",
				entryTitle = "Blogs Entry first");
			JSONBlog.addEntry(
				entryContent = "second test",
				entryTitle = "second test");
			Refresh();
		}
		task ("And: a 2 Blog Entries exists") {
			AssertElementPresent(
				key_entryTitle = "Blogs Entry first",
				key_tagName = "Blogs Entry first",
				locator1 = "BlogsEntry#TAG"
			);

			AssertElementPresent(
				key_entryTitle = "second test",
				key_tagName = "second test",
				locator1 = "BlogsEntry#TAG"
			);
		}
	
		task ("When : search for the blog entry ") {
			Testex.searchBlogEntry();
		}
		task ("Then: Check the first Blog should display") {
			AssertElementPresent(
				key_entryTitle = "Blogs Entry first",
				key_tagName = "Blogs Entry first",
				locator1 = "BlogsEntry#TAG");

	}
	    task ("And: Check the second Blog should not display") {
			AssertElementNotPresent(
				key_entryTitle = "second test",
				key_tagName = "second test",
				locator1 = "BlogsEntry#TAG");
		}
	    

}
}