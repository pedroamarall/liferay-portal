@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		task ("Open new Instance of Liferay") {
			TestCase.setUpPortalInstance();
		}

		task ("Login") {
			User.firstLoginPG();
		}

		task ("Navigate to the Instance") {
			Navigator.openURL();
		}

		task ("Given the Blogs Portlet is added to the page") {
			JSONBlog.addEntry(
				entryContent = "My first Blog",
				entryTitle = "My first Blog");

			JSONBlog.addEntry(
				entryContent = "Blogs Entry 2",
				entryTitle = "Blogs Entry 2");

			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanSuccessfullyCreateBlogEntry {
		task ("When the user adds a Blog Entry") {
			BlogsNavigator.gotoAddEntry();

			BlogsEntry.addEntryContent(
				entryContent = "New Blogs Entry",
				entryTitle = "New Blogs Entry");
		}

		task ("Then Check the Blog Entry display on the page") {
			AssertElementPresent(
				key_entryTitle = "New Blogs Entry",
				key_tagName = "New Blogs Entry",
				locator1 = "BlogsEntry#TAG");
		}
	}

	@description = "Can Delete a Blog"
	@priority = 5
	test CanSuccessfullyDeleteBlogEntry {
		task ("When delete the blog entry") {
			LexiconEntry.gotoEntryMenuItem(
				menuItem = "Delete",
				rowEntry = "Blogs Entry 2");
		}

		task ("Then Check that the blog has been delete") {
			AssertElementNotPresent(
				key_entryTitle = "Blogs Entry 2",
				key_tagName = "Blogs Entry 2",
				locator1 = "BlogsEntry#TAG");
		}
	}

	@description = " Can Edit a Blog"
	@priority = 5
	test CanSuccessfullyEditBlogEntry {
		task ("When Edit the blog title") {
			Testex.editBlogEntry(
				entryTitle = "Blogs Entry 2",
				entryTitleEdit = "This blogs has been edited");
		}

		task ("Then Check that the blog has been edited") {
			AssertElementPresent(
				key_entryTitle = "This blogs has been edited",
				key_tagName = "This blogs has been edited",
				locator1 = "BlogsEntry#TAG");
		}
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSuccessfullySearchBlogsEntries {
		task ("When search for the blog entry ") {
			BlogsEntry.searchCP(
				entryContent = "My first Blog",
				entrySearchTerm = "My first Blog",
				entryTitle = "My first Blogs");
		}

		task ("Then Check the first Blog should display") {
			AssertElementPresent(
				key_entryTitle = "My first Blog",
				key_tagName = "My first Blog",
				locator1 = "BlogsEntry#TAG");
		}

		task ("And Check the second Blog should not display") {
			AssertElementNotPresent(
				key_entryTitle = "Blogs Entry 2",
				key_tagName = "Blogs Entry 2",
				locator1 = "BlogsEntry#TAG");
		}
	}

}