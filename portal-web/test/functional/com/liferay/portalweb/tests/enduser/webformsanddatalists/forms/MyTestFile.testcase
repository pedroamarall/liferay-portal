@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();	
	}

	tearDown {
		User.logoutAndLoginPG(
 			userLoginEmailAddress = "test@liferay.com",
 			userLoginFullName = "Test Test");
	}

 
	@description = "Create a new form"
	@priority = "5" 
	test CreateNewForm {

		MyTestFile.openHome();

		MyTestFile.openContentData();

		MyTestFile.openForms();

		FormsAdmin.addForm();

		Form.editName(formName = "Form 1");

		Form.editDescription(formDescription = "Form 1 Description");

		Form.editPageTitle(
			formPageName = "Page test",
			formTitleNumber = "1");

		Form.editPageDescription(formPageDescriptionName = "Page 1 Descripton");

		Form.addTextField(fieldPositionNumber = "0");

		FormViewBuilder.editFieldLabel(
			fieldLabel = "Text",
			label = "Full name");

		Form.closeSidebar();

		Form.gotoAddField(
			fieldPositionNumber = "1",
			fieldType = "Numeric");

		FormViewBuilder.editFieldLabel(
			fieldLabel = "Numeric",	
			label = "Age");

		Form.addTranslation(localizedLanguage = "Portuguese (Brazil)");

		FormViewBuilder.editFieldLabel(
			fieldLabel = "Age",	
			label = "Idade");

		AssertTextEquals(
			locator1 = "MyTestFile#FIELD_LABEL",
			value1 = "Idade");

		MyTestFile.openTextField();

		FormViewBuilder.editFieldLabel(
			fieldLabel = "Full name",
			label = "Nome completo");

		AssertTextEquals(
			locator1 = "MyTestFile#FIELD_LABEL",
			value1 = "Nome completo");


		Form.save();

		Form.publishForm();		

	}

}

