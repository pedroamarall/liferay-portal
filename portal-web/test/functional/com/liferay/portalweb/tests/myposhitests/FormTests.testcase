@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		User.logoutPG();
	}

	@description = "Create a Form and translate titles "
	@priority = 5
	test CreateFormWithTranslation {
		task ("Given A Form is created with a Text field and a numeric field") {
			ApplicationsMenuHelper.openApplicationsMenu();

			FormsAdmin.addForm();

			TestForm.addFieldsForm(
				fieldPositionNumber = 0,
				fieldPositionNumber2 = 1,
				fieldType1 = "Text",
				fieldType2 = "Numeric",
				fieldValue_english1 = "Full Name",
				fieldValue_english2 = "Age",
				formDescription = "form ENG",
				formName = "form ENG",
				formPageName = "Created Form EN",
				formTitleNumber = 1);
		}

		task ("And The field titles are translated to french") {
			Form.addTranslation(localizedLanguage = "French (France)");

			TestForm.editFieldsForm(
				fieldValue_french1 = "Nom Prenom",
				fieldValue_french2 = "Age",
				formDescription = "form en frc",
				formName = "form frc",
				formPageName = "Creation formulaire en frc",
				formTitleNumber = 1);
		}

		task ("And We publish the Form") {
			Form.publishForm();
		}

		task ("And Navigate to the published Form") {
			FormsAdminNavigator.gotoPublishedForm();
		}

		task ("When We fill the english form") {
			TestForm.fillFormEnglish(
				fieldName_english1 = "Full Name",
				fieldName_english2 = "Age",
				fieldValue_english1 = "Mohammed",
				fieldValue_english2 = 23);
		}

		task ("And We switch to french and fill the form") {
			FormPortletConfiguration.changeLanguage(
				currentLanguage = "en-US",
				newLanguage = "français-France");

			TestForm.fillFormFrench(
				fieldName_french1 = "Nom Prenom",
				fieldName_french2 = "Age",
				fieldValue_french1 = "Mohammed",
				fieldValue_french2 = 23);
		}

		task ("And Navigate to the Forms portlet") {
			Navigator.openURL();

			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Forms");
		}

		task ("Then View and Assert Entries") {
			TestForm.checkForm(
				rowAny = "Mohammed",
				rowEntry = "Mohammed",
				rowEntry2 = "Mohammed");
		}
	}

}