@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");

		task ("Given the Blogs Portlet is added to the page") {
			JSONBlog.addEntry(
				entryContent = "Blog 1",
				entryTitle = "Blog 1");

			JSONBlog.addEntry(
				entryContent = "Blog 2",
				entryTitle = "Blog 2");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		task ("When the Blogs Portlet is added to the page") {
			BlogsNavigator.gotoAddEntry();

			BlogsEntry.addEntryContent(
				entryContent = "Extra Blog",
				entryTitle = "Extra Blog");
		}

		task ("Then Check the Blog Entry display on the page") {
			AssertElementPresent(
				key_entryTitle = "Extra Blog",
				key_tagName = "Extra Blog",
				locator1 = "BlogsEntry#TAG");
		}
	}

	@description = "Can Delete a Blog"
	@priority = 5
	test CanDeleteBlog {
		task ("When delete the blog entry") {
			LexiconEntry.gotoEntryMenuItem(
				menuItem = "Delete",
				rowEntry = "Blog 2");
		}

		task ("Then Check that the blog has been delete") {
			AssertElementNotPresent(
				key_entryTitle = "Blog 2",
				key_tagName = "Blog 2",
				locator1 = "BlogsEntry#TAG");
		}
	}

	@description = "Can Edit a Blog"
	@priority = 5
	test CanEditBlog {
		task ("When Edit the blog title") {
			TestForm.editBlogEntry(
				entryTitle = "Blog 2",
				entryTitleEdit = "Blog Mohammed");
		}

		task ("Then Check that the blog has been edited") {
			AssertElementPresent(
				key_entryTitle = "Blog Mohammed",
				key_tagName = "Blog Mohammed",
				locator1 = "BlogsEntry#TAG");
		}
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSearchBlogs {
		task ("When search for blog entry ") {
			BlogsEntry.searchCP(
				entryContent = "Blog 1",
				entrySearchTerm = "Blog 1",
				entryTitle = "Blog 1");
		}

		task ("Then Check the first Blog should display") {
			AssertElementPresent(
				key_entryTitle = "Blog 1",
				key_tagName = "Blog 1",
				locator1 = "BlogsEntry#TAG");
		}

		task ("And Check the second Blog should not display") {
			AssertElementNotPresent(
				key_entryTitle = "Blog 2",
				key_tagName = "Blog 2",
				locator1 = "BlogsEntry#TAG");
		}
	}

}