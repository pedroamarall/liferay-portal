@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		task ("Given the Blogs Portlet is added to the page") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");
		}

		task ("And the user adds a Blog Entry") {
			JSONBlog.addEntry(
				entryContent = "Blogs",
				entryTitle = "Test");

			Refresh();
		}

		task ("Then the Blog Entry should display on the page") {
			AssertElementPresent(
				key_entryTitle = "Test",
				key_tagName = "Test",
				locator1 = "BlogsEntry#TAG");
		}
	}

	@description = "Can Delete a Blog"
	@priority = 5
	test CanDeleteBlog {
		task ("Given the Blogs Portlet is added to the page And Blog Entry exists ") {
			MyBlogs.Addblog();
		}

		task ("When the Blogs Portlet is deleted from the page") {
			LexiconEntry.gotoEntryMenuItem(
				menuItem = "Delete",
				rowEntry = "Test");
		}

		task ("Then the Blogs should not exist") {
			Blogs.viewEntryNotPresent(listEntry = "Test");
		}
	}

	@description = "Can edit a Blog"
	@priority = 5
	test CanEditBlog {
		task ("Given the Blogs Portlet is added to the page And Blog Entry exists ") {
			MyBlogs.Addblog();
		}

		task ("When the User edits the blog Entry") {
			LexiconEntry.gotoEntryMenuItem(
				menuItem = "Edit",
				rowEntry = "Test");

			BlogsEntry.editTitle(
				entryTitle = "Test",
				entryTitleEdit = "New title");
		
			Button.clickPublish();
		}

		task("Then the blog Entry should be edited and displayed") {
            AssertElementPresent(
				key_entryTitle = "New title",
				key_tagName = "New title",
				locator1 = "BlogsEntry#TAG");

		}
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSearchBlogsEntrySuccessfully {
		task ("Given the Blogs Portlet is added to the page And Blog Entry exists ") {
			MyBlogs.Addblog();
		}

		task ("When user searched for blog entry ") {
			BlogsEntry.searchCP(
				entrySearchTerm = "Test",
				entryTitle = "Test");
		}

		task ("Then Blog Entry should display ") {
			AssertElementPresent(
				key_entryTitle = "Test",
				key_tagName = "Test",
				locator1 = "BlogsEntry#TAG");
		}
	}

}