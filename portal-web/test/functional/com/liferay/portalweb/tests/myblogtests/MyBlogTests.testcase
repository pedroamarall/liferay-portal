@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Blog"
	@priority = "5"
	test CanCreateBlog {
		Navigator.gotoPage(pageName = "Blogs Page");

		Blogs.addEntry(
			entryContent = "This is a example of the Blog",
			entryTitle = "Blog of example");

		AssertClick(
			locator1 = "Button#PUBLISH",
			value1 = "Publish");

		Alert.viewSuccessMessage();
	}

	@description = "Can Delete a Blog"
	@priority = "5"
	test CanDeleteBlog {
		BlogsNavigator.openToBlogEntry(
			entryTitle = "New Blog",
			layoutName = "Blogs Page",
			siteURLKey = "guest");

		BlogsEntry.tearDownCP();

		JSONGroup.deleteGroupByName(groupName = "Site Name");
	}

	@description = "Can Create a Blog"
	@priority = "5"
	test CanEditBlog {
		BlogsNavigator.openToEditEntryInSite(
			entryTitle = "Blog of example",
			groupName = "Guest",
			siteURLKey = "guest");

		BlogsEntry.editContent(
			entryContent = "This is a example of the Blog",
			entryContentEdit = "I Edited this content");

		PortletEntry.publish();
	}

	@description = "Can Search Blogs"
	@priority = "5"
	test CanSearchBlog {
		Navigator.openURL();

		SearchPortlets.searchEmbedded(searchTerm = "blog of example");

		SearchResultPortlet.viewSearchResults(
			searchAssetSummary = "Blogs Entry Content",
			searchAssetTitle = "Blogs Entry Title",
			searchAssetType = "Blogs Entry");

		SearchPortlets.searchEmbedded(searchTerm = "example");

		SearchResultPortlet.viewSearchResults(
			searchAssetSummary = "Blogs Entry Content",
			searchAssetTitle = "Blogs Entry Title",
			searchAssetType = "Blogs Entry");
	}

}